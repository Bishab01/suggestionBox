# Lets React Router handle deep links (/admin/dashboard, /login ...) on
# Apache hosts such as InfinityFree. Vite copies this file into dist/.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
